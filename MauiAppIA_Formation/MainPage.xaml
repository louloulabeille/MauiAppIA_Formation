<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppIA_Formation.MainPage"
             Shell.BackgroundColor="DarkOrange"
             Title="Requête">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            BackgroundColor="DarkOrange">
            <Label
                Text="Mistral Ai"
                FontSize="22"
                TextColor="Black"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Border StrokeThickness="0" BackgroundColor="LightGrey" StrokeShape="RoundRectangle 10,10,10,10">
                <Label Text="" x:Name="ResponseLabel" TextColor="black" FontSize="18"/>
            </Border>
            <Border StrokeThickness="0" BackgroundColor="LightGrey" StrokeShape="RoundRectangle 10,10,10,10">
                <Entry Placeholder="Votre question..." x:Name="QuestionEntry"  TextColor="black" FontSize="18"/>
            </Border>
            
            <Button
                x:Name="SendBtn"
                Text="Envoyer" 
                Clicked="OnSendClicked"
                HorizontalOptions="Center" 
                BackgroundColor="LightGrey" 
                WidthRequest="150"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
